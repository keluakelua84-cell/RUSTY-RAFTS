local lastSlow, lastWave = 0, 0
track(RunService.Heartbeat:Connect(function(dt)
	if not alive then return end
	if lock.on then
		local root = myRoot()
		if root and lock.part and lock.part.Parent then
			root.CFrame = lock.part.CFrame * lock.off
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
		elseif root then
			local part = findShipPart()
			if part then lock.part = part; lock.off = part.CFrame:ToObjectSpace(root.CFrame) end
		end
	end
	if S.SpeedBoost and not lock.on then pcall(speedStep, dt) end
	if S.FreezeSea then pcall(seaStep) end
	local now = tick()
	if now - lastSlow >= 0.1 then
		lastSlow = now
		if S.InfStamina then pcall(stamStep) end
	end
	if S.FreezeSea and now - lastWave >= 1 then
		lastWave = now
		Terrain.WaterWaveSize = 0
		Terrain.WaterWaveSpeed = 0
	end
end))

