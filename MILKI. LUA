----------------------------------------------------------------- utils
local function rnd()
	local t = {}
	for i = 1, 10 do t[i] = string.char(math.random(97, 122)) end
	return table.concat(t)
end

local function hasWordL(l, list)
	for _, w in ipairs(list) do
		if string.find(l, w, 1, true) then return true end
	end
	return false
end

local function hasWord(str, list)
	return hasWordL(string.lower(tostring(str)), list)
end

local function myRoot()
	local c = LP.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end

local function myHum()
	local c = LP.Character
	return c and c:FindFirstChildOfClass("Humanoid")
end

local function pickPart(m)
	for _, n in ipairs(CFG.AIM_PARTS) do
		local p = m:FindFirstChild(n)
		if p and p:IsA("BasePart") then return p end
	end
	return m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart")
end

local function anyPart(inst)
	if inst:IsA("BasePart") then return inst end
	if inst:IsA("Attachment") then return inst.Parent and inst.Parent:IsA("BasePart") and inst.Parent or nil end
	if inst:IsA("Model") then return inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart", true) end
	return nil
end

