----------------------------------------------------------------- esp drawing
local function makeEntry(color)
	local e = {}
	e.box = Instance.new("Frame")
	e.box.BackgroundTransparency = 1; e.box.BorderSizePixel = 0; e.box.Visible = false; e.box.Parent = overlay
	local st = Instance.new("UIStroke"); st.Color = color; st.Thickness = 1.5; st.Parent = e.box
	e.label = Instance.new("TextLabel")
	e.label.BackgroundTransparency = 1; e.label.TextColor3 = color; e.label.TextSize = 13
	e.label.Font = Enum.Font.GothamBold; e.label.TextStrokeTransparency = 0.4
	e.label.Size = UDim2.fromOffset(240, 16); e.label.AnchorPoint = Vector2.new(0.5, 1)
	e.label.Visible = false; e.label.Parent = overlay
	e.line = Instance.new("Frame")
	e.line.BorderSizePixel = 0; e.line.BackgroundColor3 = color
	e.line.AnchorPoint = Vector2.new(0.5, 0.5); e.line.Visible = false; e.line.Parent = overlay
	return e
end

local function hideEntry(e)
	e.box.Visible = false; e.label.Visible = false; e.line.Visible = false
end

local function destroyEntry(e)
	e.box:Destroy(); e.label:Destroy(); e.line:Destroy()
end

local function projectBox(cam, rec, part)
	local cf, size = part.CFrame, part.Size
	if rec.kind == "enemy" then
		local ok, c, s = pcall(rec.inst.GetBoundingBox, rec.inst)
		if ok and s.Magnitude < 60 then cf, size = c, s end
	end
	local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
	local any = false
	for x = -1, 1, 2 do
		for y = -1, 1, 2 do
			for z = -1, 1, 2 do
				local p = cam:WorldToViewportPoint(cf:PointToWorldSpace(Vector3.new(size.X / 2 * x, size.Y / 2 * y, size.Z / 2 * z)))
				if p.Z > 0 then
					any = true
					if p.X < minX then minX = p.X end
					if p.Y < minY then minY = p.Y end
					if p.X > maxX then maxX = p.X end
					if p.Y > maxY then maxY = p.Y end
				end
			end
		end
	end
	if not any then return nil end
	if maxX - minX < 14 then local c = (maxX + minX) / 2; minX, maxX = c - 7, c + 7 end
	if maxY - minY < 14 then local c = (maxY + minY) / 2; minY, maxY = c - 7, c + 7 end
	return minX, minY, maxX, maxY
end

local function drawLine(frame, a, b)
	local d = b - a
	frame.Size = UDim2.fromOffset(d.Magnitude, 1.5)
	frame.Position = UDim2.fromOffset((a.X + b.X) / 2, (a.Y + b.Y) / 2)
	frame.Rotation = math.deg(math.atan2(d.Y, d.X))
	frame.Visible = true
end

local enemies, loot = {}, {}
local ENEMY_COLOR = Color3.fromRGB(255, 70, 70)
local LOOT_COLOR = Color3.fromRGB(80, 220, 255)

local function partOf(rec)
	if rec.kind == "enemy" then return pickPart(rec.inst) end
	if rec.kind == "tool" then return rec.obj:FindFirstChild("Handle") or rec.obj:FindFirstChildWhichIsA("BasePart") end
	if rec.kind == "obj" then return anyPart(rec.obj) end
	local p = rec.obj.Parent
	return p and anyPart(p) or nil
end

local function recAlive(rec)
	if not rec.inst.Parent then return false end
	if rec.hum then return rec.hum.Health > 0 end
	return true
end

local function render(rec, color, wantLabel, wantBox, wantTracer, cam, rootPos, from)
	local e = rec.e
	local shown = false
	if wantLabel or wantBox or wantTracer then
		local part = partOf(rec)
		if part and part.Parent and (rec.kind ~= "enemy" or recAlive(rec)) then
			local dist = rootPos and (part.Position - rootPos).Magnitude or 0
			if dist <= CFG.MAX_ESP_DIST then
				local p = cam:WorldToViewportPoint(part.Position)
				if p.Z > 0 then
					shown = true
					if not e then e = makeEntry(color); rec.e = e end
					local minX, minY, maxX, maxY = projectBox(cam, rec, part)
					if wantBox and minX then
						e.box.Position = UDim2.fromOffset(minX, minY)
						e.box.Size = UDim2.fromOffset(maxX - minX, maxY - minY)
						e.box.Visible = true
					else
						e.box.Visible = false
					end
					if wantLabel then
						local txt = rec.name .. " [" .. math.floor(dist) .. "m]"
						if rec.hum then txt = txt .. " HP " .. math.floor(rec.hum.Health) end
						e.label.Text = txt
						e.label.Position = UDim2.fromOffset(p.X, (minY or p.Y) - 2)
						e.label.Visible = true
					else
						e.label.Visible = false
					end
					if wantTracer then
						drawLine(e.line, from, Vector2.new(p.X, p.Y))
					else
						e.line.Visible = false
					end
				end
			end
		end
	end
	if not shown and e then hideEntry(e) end
end

----------------------------------------------------------------- scanning
local disasterInst, disasterVals = {}, {}

local function promptLabel(pr)
	local base = pr.ObjectText ~= "" and pr.ObjectText or nil
	if not base then
		local m = pr:FindFirstAncestorWhichIsA("Model")
		base = (m and m.Name) or (pr.Parent and pr.Parent.Name) or "item"
	end
	if pr.ActionText ~= "" then return base .. " (" .. pr.ActionText .. ")" end
	return base
end

local function promptMatch(pr)
	local parentName = pr.Parent and pr.Parent.Name or ""
	return hasWord(pr.ActionText .. " " .. pr.ObjectText .. " " .. parentName, CFG.LOOT_WORDS)
end

local function isOtherChar(inst)
	local c = LP.Character
	if c and (inst == c or inst:IsDescendantOf(c)) then return true end
	return false
end

local function consider(inst)
	local l = string.lower(inst.Name)
	if inst:IsA("Humanoid") then
		local m = inst.Parent
		if m and m:IsA("Model") and not Players:GetPlayerFromCharacter(m) then
			local r = enemies[m]
			if r then
				r.hum = inst
			else
				enemies[m] = { kind = "enemy", inst = m, hum = inst, name = m.Name }
			end
		end
	elseif inst:IsA("ProximityPrompt") then
		if not loot[inst] then
			loot[inst] = { kind = "prompt", obj = inst, inst = inst, name = promptLabel(inst), match = promptMatch(inst) }
		end
	elseif inst:IsA("ClickDetector") then
		if not loot[inst] then
			local p = inst.Parent
			loot[inst] = { kind = "click", obj = inst, inst = inst, name = (p and p.Name or "click"), match = true }
		end
	elseif inst:IsA("Tool") and inst.Parent == WS_REAL then
		loot[inst] = { kind = "tool", obj = inst, inst = inst, name = inst.Name, match = true }
	elseif inst:IsA("Model") then
		if S.NameDetect and not enemies[inst] and hasWordL(l, CFG.ENEMY_NAME_WORDS)
			and not Players:GetPlayerFromCharacter(inst) and not isOtherChar(inst)
			and not (inst.Parent and enemies[inst.Parent]) then
			enemies[inst] = { kind = "enemy", inst = inst, name = inst.Name }
		end
	end
	if (inst:IsA("Model") or inst:IsA("BasePart")) and not loot[inst] and not enemies[inst]
		and hasWordL(l, CFG.LOOT_OBJECT_WORDS) and not isOtherChar(inst)
		and not (inst.Parent and hasWordL(string.lower(inst.Parent.Name), CFG.LOOT_OBJECT_WORDS)) then
		loot[inst] = { kind = "obj", obj = inst, inst = inst, name = inst.Name, match = true }
	end
	if inst:IsA("ValueBase") then
		if hasWordL(l, CFG.DISASTER_WORDS) or hasWordL(l, CFG.VALUE_EXTRA_WORDS) then
			disasterVals[inst] = true
		end
	elseif hasWordL(l, CFG.DISASTER_WORDS) then
		disasterInst[inst] = true
	end
end

local function unconsider(inst)
	local r = enemies[inst]
	if r then if r.e then destroyEntry(r.e) end enemies[inst] = nil end
	if inst:IsA("Humanoid") and inst.Parent then
		local r2 = enemies[inst.Parent]
		if r2 and r2.hum == inst then r2.hum = nil end
	end
	local lr = loot[inst]
	if lr then if lr.e then destroyEntry(lr.e) end loot[inst] = nil end
	disasterInst[inst] = nil
	disasterVals[inst] = nil
end

task.spawn(function()
	local n = 0
	for _, d in ipairs(WS:GetDescendants()) do
		if not alive then return end
		pcall(consider, d)
		n += 1
		if n % 800 == 0 then task.wait() end
	end
	for _, d in ipairs(RepStorage:GetDescendants()) do
		if not alive then return end
		if d:IsA("ValueBase") then
			local l = string.lower(d.Name)
			if hasWordL(l, CFG.DISASTER_WORDS) or hasWordL(l, CFG.VALUE_EXTRA_WORDS) then disasterVals[d] = true end
		end
		n += 1
		if n % 800 == 0 then task.wait() end
	end
end)
track(WS.DescendantAdded:Connect(function(d) pcall(consider, d) end))
track(WS.DescendantRemoving:Connect(function(d) pcall(unconsider, d) end))
track(RepStorage.DescendantAdded:Connect(function(d)
	if d:IsA("ValueBase") then
		local l = string.lower(d.Name)
		if hasWordL(l, CFG.DISASTER_WORDS) or hasWordL(l, CFG.VALUE_EXTRA_WORDS) then disasterVals[d] = true end
	end
end))
track(RepStorage.DescendantRemoving:Connect(function(d) disasterVals[d] = nil end))

task.spawn(function()
	while alive do
		task.wait(3)
		for inst, rec in pairs(loot) do
			if rec.kind == "prompt" and inst.Parent then
				rec.match = promptMatch(inst)
				rec.name = promptLabel(inst)
			end
		end
		-- drop enemies detected by name when the toggle is switched off
		if not S.NameDetect then
			for m, rec in pairs(enemies) do
				if not rec.hum then
					if rec.e then destroyEntry(rec.e) end
					enemies[m] = nil
				end
			end
		end
	end
end)

----------------------------------------------------------------- aim / camera / auto hit
local aimPart = nil

local function updateAim()
	aimPart = nil
	if not (S.SilentAim or S.CameraLock or S.AutoHit) then return end
	local cam = WS.CurrentCamera
	if not cam then return end
	local vs = cam.ViewportSize
	local center = Vector2.new(vs.X / 2, vs.Y / 2)
	local best = S.FOV
	for m, rec in pairs(enemies) do
		if recAlive(rec) then
			local part = pickPart(m)
			if part then
				local p, on = cam:WorldToViewportPoint(part.Position)
				if on then
					local d = (Vector2.new(p.X, p.Y) - center).Magnitude
					if d < best then best = d; aimPart = part end
				end
			end
		end
	end
end

local bindName = rnd()
RunService:BindToRenderStep(bindName, Enum.RenderPriority.Camera.Value + 1, function()
	if not alive then return end
	updateAim()
	if S.CameraLock and aimPart then
		local cam = WS.CurrentCamera
		if cam then
			local cf = cam.CFrame
			cam.CFrame = cf:Lerp(CFrame.lookAt(cf.Position, aimPart.Position), 0.4)
		end
	end
end)

local fireBtn, fireScan = nil, 0
local function getFireButton()
	if fireBtn and fireBtn.Parent and fireBtn.Visible then return fireBtn end
	if tick() - fireScan < 3 then return nil end
	fireScan = tick(); fireBtn = nil
	local pg = LP:FindFirstChildOfClass("PlayerGui")
	if pg then
		for _, d in ipairs(pg:GetDescendants()) do
			if d:IsA("GuiButton") and d.Visible and not d:IsDescendantOf(gui) then
				local txt = d.Name .. (d:IsA("TextButton") and (" " .. d.Text) or "")
				if hasWord(txt, CFG.FIRE_BUTTON_WORDS) then fireBtn = d; break end
			end
		end
	end
	return fireBtn
end

local function pressButton(b)
	for _, n in ipairs({ "MouseButton1Down", "MouseButton1Click", "Activated", "MouseButton1Up" }) do
		local sig = b[n]
		if firesignal then
			pcall(firesignal, sig)
		elseif getconnections then
			pcall(function()
				for _, c in ipairs(getconnections(sig)) do c:Fire() end
			end)
		end
	end
end

local function fireOnce()
	local fired = false
	local char = LP.Character
	local tool = char and char:FindFirstChildOfClass("Tool")
	if tool then pcall(function() tool:Activate() end); fired = true end
	local btn = getFireButton()
	if btn then pressButton(btn); fired = true end
	if not fired and mouse1click then pcall(mouse1click) end
end

task.spawn(function()
	while alive do
		task.wait(0.12)
		if S.AutoHit and aimPart then
			local root = myRoot()
			if root and (aimPart.Position - root.Position).Magnitude <= S.HitRange then
				pcall(fireOnce)
			end
		end
	end
end)

----------------------------------------------------------------- hooks (silent aim + remote spy)
local ncc = newcclosure or function(f) return f end
local oldNC, oldIdx
local spyLog, spyOrder = {}, {}

local function short(v)
	local t = typeof(v)
	if t == "string" then return '"' .. string.sub(v, 1, 40) .. '"' end
	if t == "Instance" then return v.ClassName .. ":" .. v.Name end
	if t == "table" then return "{table}" end
	return tostring(v)
end

local function logRemote(self, method, ...)
	if typeof(self) ~= "Instance" then return end
	local path = self:GetFullName()
	local rec = spyLog[path]
	if not rec then
		rec = { n = 0, method = method, class = self.ClassName }
		spyLog[path] = rec
		spyOrder[#spyOrder + 1] = path
	end
	rec.n += 1
	local parts = {}
	for i = 1, select("#", ...) do
		parts[i] = short((select(i, ...)))
		if i >= 8 then break end
	end
	rec.args = table.concat(parts, ", ")
end

local function installHooks()
	if oldNC or not hookmetamethod then return end
	oldNC = hookmetamethod(game, "__namecall", ncc(function(self, ...)
		if alive and not (checkcaller and checkcaller()) then
			local m = getnamecallmethod()
			if m == "Raycast" and S.SilentAim and aimPart and self == WS_REAL then
				local n = select("#", ...)
				local a = { ... }
				if typeof(a[1]) == "Vector3" and typeof(a[2]) == "Vector3" and a[2].Magnitude > 0 then
					a[2] = (aimPart.Position - a[1]).Unit * a[2].Magnitude
					return oldNC(self, table.unpack(a, 1, n))
				end
			elseif S.RemoteSpy and (m == "FireServer" or m == "InvokeServer") then
				pcall(logRemote, self, m, ...)
			end
		end
		return oldNC(self, ...)
	end))
	local mouse = LP:GetMouse()
	oldIdx = hookmetamethod(game, "__index", ncc(function(self, k)
		if alive and S.SilentAim and aimPart and self == mouse and not (checkcaller and checkcaller()) then
			if k == "Hit" then return CFrame.new(aimPart.Position) end
			if k == "Target" then return aimPart end
		end
		return oldIdx(self, k)
	end))
end

----------------------------------------------------------------- stamina
local stam, stamGc = {}, {}
local STAM_SKIP = { "regen", "rate", "cost", "drain", "max" }

local function scanStamina()
	local list = {}
	local function addAttrs(inst)
		for k, v in pairs(inst:GetAttributes()) do
			if type(v) == "number" and hasWord(k, CFG.STAMINA_WORDS) and not hasWord(k, STAM_SKIP) then
				local mx = inst:GetAttribute("Max" .. k)
				list[#list + 1] = { o = inst, attr = k, max = type(mx) == "number" and mx or v }
			end
		end
	end
	local function addValue(d)
		if (d:IsA("NumberValue") or d:IsA("IntValue")) and hasWord(d.Name, CFG.STAMINA_WORDS) and not hasWord(d.Name, STAM_SKIP) then
			local mxv = d.Parent and d.Parent:FindFirstChild("Max" .. d.Name)
			list[#list + 1] = { o = d, max = (mxv and mxv:IsA("ValueBase") and tonumber(mxv.Value)) or d.Value }
		end
	end
	local char = LP.Character
	addAttrs(LP)
	if char then
		addAttrs(char)
		local h = char:FindFirstChildOfClass("Humanoid")
		if h then addAttrs(h) end
	end
	for _, r in ipairs({ LP, char }) do
		if r then
			for _, d in ipairs(r:GetDescendants()) do addValue(d) end
		end
	end
	local n = 0
	for _, d in ipairs(RepStorage:GetDescendants()) do
		n += 1
		if n % 500 == 0 then task.wait() end
		if (d:IsA("NumberValue") or d:IsA("IntValue")) and (d:FindFirstAncestor(LP.Name) or d:FindFirstAncestor(tostring(LP.UserId))) then
			addValue(d)
		end
	end
	stam = list
end

local function gcScan()
	if not getgc then return {} end
	local found = {}
	pcall(function()
		local all = getgc(true)
		for i, v in ipairs(all) do
			if type(v) == "table" then
				for k, val in next, v do
					if type(k) == "string" and type(val) == "number" and hasWord(k, CFG.STAMINA_WORDS) and not hasWord(k, STAM_SKIP) then
						local mx = rawget(v, "Max" .. k) or rawget(v, k .. "Max")
						found[#found + 1] = { t = v, k = k, max = type(mx) == "number" and mx or val }
						if #found >= 20 then return end
					end
				end
			end
			if i % 3000 == 0 then task.wait() end
		end
	end)
	return found
end

local function stamStep()
	for _, ref in ipairs(stam) do
		if ref.o and ref.o.Parent then
			local cur
			if ref.attr then cur = ref.o:GetAttribute(ref.attr) else cur = ref.o.Value end
			if type(cur) == "number" then
				if cur > ref.max then ref.max = cur end
				if cur < ref.max then
					if ref.attr then ref.o:SetAttribute(ref.attr, ref.max) else ref.o.Value = ref.max end
				end
			end
		end
	end
	for _, ref in ipairs(stamGc) do
		local cur = rawget(ref.t, ref.k)
		if type(cur) == "number" then
			if cur > ref.max then ref.max = cur end
			if cur < ref.max then pcall(rawset, ref.t, ref.k, ref.max) end
		end
	end
end

task.spawn(function()
	while alive do
		pcall(scanStamina)
		task.wait(5)
	end
end)

----------------------------------------------------------------- speed boost
local function speedStep(dt)
	local root, hum = myRoot(), myHum()
	if root and hum and hum.MoveDirection.Magnitude > 0 then
		root.CFrame = root.CFrame + hum.MoveDirection * hum.WalkSpeed * CFG.SPEED_MULT * dt
	end
end

