local function scanReport()
	local lines = {}
	local function count(map, keyFn)
		local c, order = {}, {}
		for _, rec in pairs(map) do
			local k = keyFn(rec)
			if not c[k] then c[k] = 0; order[#order + 1] = k end
			c[k] += 1
		end
		table.sort(order)
		return c, order
	end
	local ec, eo = count(enemies, function(r) return r.name .. (r.hum and "" or " (no humanoid)") end)
	lines[#lines + 1] = "== enemies =="
	for i, k in ipairs(eo) do if i <= 30 then lines[#lines + 1] = k .. " x" .. ec[k] end end
	local lc, lo = count(loot, function(r) return r.kind .. ": " .. r.name end)
	lines[#lines + 1] = "== items =="
	for i, k in ipairs(lo) do if i <= 40 then lines[#lines + 1] = k .. " x" .. lc[k] end end
	lines[#lines + 1] = "== workspace children =="
	for i, c in ipairs(WS_REAL:GetChildren()) do
		if i <= 60 then lines[#lines + 1] = c.ClassName .. " " .. c.Name end
	end
	lines[#lines + 1] = "== replicatedstorage children =="
	for i, c in ipairs(RepStorage:GetChildren()) do
		if i <= 40 then lines[#lines + 1] = c.ClassName .. " " .. c.Name end
	end
	lines[#lines + 1] = "== stamina refs: " .. #stam .. " values, " .. #stamGc .. " gc"
	lines[#lines + 1] = "== sea: " .. tostring(water.y) .. " (" .. water.src .. ")"
	return table.concat(lines, "\n")
end

