local origWave = { Terrain.WaterWaveSize, Terrain.WaterWaveSpeed }
local water = { y = nil, src = "none", t = 0, offset = 0 }
local PARKED = CFrame.new(0, -1e4, 0)

local function isWaterName(l)
	if string.find(l, "water", 1, true) or string.find(l, "ocean", 1, true) or string.find(l, "wave", 1, true) then return true end
	return string.match(l, "^sea$") ~= nil or string.match(l, "^sea[^a-z]") ~= nil
		or string.match(l, "[^a-z]sea$") ~= nil or string.match(l, "[^a-z]sea[^a-z]") ~= nil
end

local function isWaterInst(inst)
	local cur, n = inst, 0
	while cur and cur ~= WS_REAL and n < 4 do
		if isWaterName(string.lower(cur.Name)) then return true end
		cur = cur.Parent
		n += 1
	end
	return false
end

local function castParams()
	local ex = { platform }
	if LP.Character then ex[#ex + 1] = LP.Character end
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	rp.IgnoreWater = false
	rp.FilterDescendantsInstances = ex
	return rp, ex
end

-- casts down through ships/objects until it reaches water; returns surface Y
local function detectSea(root)
	local rp, ex = castParams()
	local origin = root.Position + Vector3.new(0, 4, 0)
	for _ = 1, 6 do
		rp.FilterDescendantsInstances = ex
		local r = WS:Raycast(origin, Vector3.new(0, -400, 0), rp)
		if not r then return nil end
		if r.Material == Enum.Material.Water or isWaterInst(r.Instance) then return r.Position.Y end
		if r.Instance == Terrain then return nil end
		ex[#ex + 1] = r.Instance
	end
	return nil
end

local function feetOffset(root, hum)
	return math.max(3, hum.HipHeight + root.Size.Y / 2)
end

local function seaStep()
	local root, hum = myRoot(), myHum()
	if not (root and hum) then return end
	local now = tick()
	if now - water.t > 0.5 then
		water.t = now
		local y = detectSea(root)
		if y then
			water.y = y; water.src = "detected"
		elseif not water.y and hum:GetState() == Enum.HumanoidStateType.Swimming then
			water.y = root.Position.Y + 1; water.src = "swim"
		end
	end
	platform.Transparency = S.ShowBlock and 0.55 or 1
	if not water.y then platform.CFrame = PARKED return end
	local pos = root.Position
	local rp = castParams()
	local r = WS:Raycast(pos, Vector3.new(0, -8, 0), rp)
	local onSolid = r and r.Material ~= Enum.Material.Water and not isWaterInst(r.Instance)
	if onSolid then
		platform.CFrame = PARKED
		return
	end
	local top = water.y + 0.1 + water.offset
	platform.CFrame = CFrame.new(pos.X, top - 0.5, pos.Z)
	local feet = pos.Y - feetOffset(root, hum)
	if feet < top - 1 and feet > top - 40 then
		root.CFrame = root.CFrame + Vector3.new(0, top + feetOffset(root, hum) + 0.2 - pos.Y, 0)
		local v = root.AssemblyLinearVelocity
		root.AssemblyLinearVelocity = Vector3.new(v.X, 0, v.Z)
	end
end

local function setSea(on)
	if on then
		Terrain.WaterWaveSize = 0
		Terrain.WaterWaveSpeed = 0
		platform.Parent = WS_REAL
	else
		Terrain.WaterWaveSize = origWave[1]
		Terrain.WaterWaveSpeed = origWave[2]
		platform.CFrame = PARKED
		platform.Parent = nil
	end
end

----------------------------------------------------------------- ship lock (disasters)
local lock = { on = false, part = nil, off = nil, mode = nil, since = 0, cool = 0, releaseAt = nil }
local disasterName = nil

local function findShipPart()
	local root = myRoot()
	if not root then return nil end
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	local ex = { platform }
	if LP.Character then ex[2] = LP.Character end
	rp.FilterDescendantsInstances = ex
	local r = WS:Raycast(root.Position, Vector3.new(0, -15, 0), rp)
	if r and r.Instance and r.Instance:IsA("BasePart") and r.Instance ~= Terrain then return r.Instance end
	return nil
end

local function startLock(mode)
	local root, part = myRoot(), findShipPart()
	if not (root and part) then return false end
	lock.on = true; lock.mode = mode; lock.part = part
	lock.off = part.CFrame:ToObjectSpace(root.CFrame)
	lock.since = tick(); lock.releaseAt = nil
	return true
end

local function stopLock()
	lock.on = false; lock.part = nil; lock.mode = nil
end

local function truthy(v, nameMatch)
	local t = type(v)
	if t == "boolean" then return v and nameMatch end
	if t == "number" then return v > 0 and nameMatch end
	if t == "string" then
		local l = string.lower(v)
		if hasWordL(l, CFG.DISASTER_WORDS) then return true end
		return nameMatch and l ~= "" and l ~= "none" and l ~= "false" and l ~= "0" and l ~= "calm" and l ~= "clear"
	end
	return false
end

local function disasterActive()
	for inst in pairs(disasterInst) do
		if inst.Parent then return true, inst.Name end
	end
	for inst in pairs(disasterVals) do
		if inst.Parent then
			local nm = hasWord(inst.Name, CFG.DISASTER_WORDS)
			if truthy(inst.Value, nm) then return true, inst.Name .. "=" .. tostring(inst.Value) end
		end
	end
	for _, r in ipairs({ WS_REAL, RepStorage }) do
		for k, v in pairs(r:GetAttributes()) do
			if truthy(v, hasWord(k, CFG.DISASTER_WORDS) or hasWord(k, CFG.VALUE_EXTRA_WORDS)) then
				return true, k .. "=" .. tostring(v)
			end
		end
	end
	return false, nil
end

task.spawn(function()
	while alive do
		task.wait(0.4)
		if S.AutoLock then
			local active, who = disasterActive()
			disasterName = active and who or nil
			if active then
				lock.releaseAt = nil
				if not lock.on then
					if tick() > lock.cool then startLock("auto") end
				elseif lock.mode == "auto" and tick() - lock.since > CFG.MAX_LOCK_SECONDS then
					stopLock(); lock.cool = tick() + 30
				end
			elseif lock.on and lock.mode == "auto" then
				if not lock.releaseAt then
					lock.releaseAt = tick() + CFG.AFTER_DISASTER_DELAY
				elseif tick() >= lock.releaseAt then
					stopLock()
				end
			end
		else
			disasterName = nil
			if lock.on and lock.mode == "auto" then stopLock() end
		end
	end
end)

